# ============================================================
# ZUUP OPPORTUNITY AGENT — Environment Variables Template
# ============================================================
# Copy this file to .env and customize.
# All 🔑 SECRET values are optional for development/MVP due to
# local storage and offline mock fallback logic.
# ============================================================

# ── APP ──────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=zuup-opportunity-agent
DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# ── DATABASE ─────────────────────────────────────────────────
# Local Dev: postgres container started via docker-compose
DATABASE_URL=postgresql://zuup_user:zuup_pass@localhost:5432/zuup_db

# ── REDIS ────────────────────────────────────────────────────
# Local Dev: redis container started via docker-compose (used as Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# ── AWS S3 (OPTIONAL) ────────────────────────────────────────
# If left blank, resumes will be saved/loaded from local storage (backend/storage/)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_RESUME_PREFIX=resumes/

# ── AI / LLM (OPTIONAL) ──────────────────────────────────────
# Anthropic — used for resume parsing & opportunity normalization
# If left blank, the app uses a regex/keyword mock fallback parser
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI — used for semantic matching embeddings
# If left blank, the app generates deterministic mock vector embeddings locally
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ── AUTH ─────────────────────────────────────────────────────
# JWT Secret Key — default local key is fallback in config.py
JWT_SECRET_KEY=zuup-super-secret-dev-key-change-in-production-12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth 2.0 (OPTIONAL)
# If left blank, Google login redirects user to use email/password login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── EMAIL (OPTIONAL) ─────────────────────────────────────────
# SendGrid API key — if left blank, emails are skipped and logged
SENDGRID_API_KEY=
FROM_EMAIL=noreply@zuup.io
FROM_NAME=Zuup

# ── RATE LIMITING ────────────────────────────────────────────
RATE_LIMIT_AUTHENTICATED=100
RATE_LIMIT_UNAUTHENTICATED=10
RATE_LIMIT_WINDOW_SECONDS=60

# ── MATCHING ENGINE ──────────────────────────────────────────
MIN_MATCH_SCORE=30
RECENCY_BONUS_HOURS=48
RECENCY_BONUS_POINTS=10
SKILL_MATCH_BONUS=5
SKILL_MATCH_MAX_BONUS=20
LOCATION_MATCH_BONUS=5
DEDUP_COSINE_THRESHOLD=0.92

# ── INGESTION ────────────────────────────────────────────────
INGESTION_MIN_DESCRIPTION_WORDS=50
INGESTION_HACKATHON_INTERVAL_HOURS=4
INGESTION_SCHOLARSHIP_INTERVAL_HOURS=24
INGESTION_INTERNSHIP_INTERVAL_HOURS=6
INGESTION_EXCHANGE_INTERVAL_HOURS=168

# ── SCRAPER PROXIES (OPTIONAL) ───────────────────────────────
SCRAPER_PROXY_URL=
SCRAPER_USER_AGENT=ZuupBot/1.0 (+https://zuup.io/bot)
